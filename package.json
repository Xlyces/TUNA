{
  "name": "tuna-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "build": "npm run build:server && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "verify:build": "test -f dist/server/server/index.js && echo 'Build verified: dist/server/server/index.js exists' || (echo 'ERROR: dist/server/server/index.js not found after build' && exit 1)",
    "preview": "vite preview",
    "start": "node dist/server/server/index.js",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:contracts": "hardhat test",
    "test:contracts:coverage": "hardhat coverage",
    "compile": "hardhat compile",
    "deploy:mumbai": "hardhat run scripts/deploy.js --network mumbai",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "emulators": "firebase emulators:start --project demo-tuna",
    "emulators:exec": "firebase emulators:exec --only firestore,auth",
    "seed:users": "tsx scripts/seed-demo-users.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.0",
    "@rainbow-me/rainbowkit": "^2.0.0",
    "@stripe/stripe-js": "^4.7.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "ethers": "^6.0.0",
    "express": "^4.18.2",
    "firebase": "^10.13.0",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "lucide-react": "^0.454.0",
    "module-alias": "^2.3.3",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.20.0",
    "stripe": "^17.3.0",
    "tailwind-merge": "^2.5.0",
    "tesseract.js": "^5.1.0",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0",
    "zod": "^3.23.8"
  },
  "_moduleAliases": {
    "@": "."
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.0.0",
    "@playwright/test": "^1.48.0",
    "@sentry/nextjs": "^8.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "chai": "^4.5.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.10",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "solidity-coverage": "^0.8.17",
    "supertest": "^7.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typechain": "^8.3.2",
    "typescript": "^5",
    "vite": "^5.0.0"
  }
}
